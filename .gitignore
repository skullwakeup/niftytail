# --- Generated run reports (regenerable; may contain derived daily series) -
/reports/runs/
# Next-day forecasts from data/raw + data/live (D58); data/live/ is covered by /data/
/reports/live/
# EDA figures show the daily series; regenerated by `python -m niftytail eda` (D29)
reports/eda/figures/
# Day-7C figures derived from per-day data (exceedance timeline, QQ, indicator ACF; D36)
reports/threshold_selection/real/figures/
# Day-8A figures derived from per-day residuals (same three; D38)
reports/threshold_selection/real_residuals/figures/

